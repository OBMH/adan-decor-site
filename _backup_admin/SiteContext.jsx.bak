const STORAGE_KEY = "aden_unified_site_data_v4";

const ensureUniqueIds = (items, prefix = "item") => {
  if (!Array.isArray(items)) return [];
  const seen = new Set();
  return items.map((item, idx) => {
    let id = item?.id;
    if (id === undefined || id === null || id === "" || seen.has(String(id))) {
      id = `${prefix}_${Date.now()}_${idx}_${Math.random().toString(36).substring(2, 7)}`;
    }
    seen.add(String(id));
    return { ...item, id };
  });
};

const generateUniqueId = (prefix = "item") => {
  return `${prefix}_${Date.now()}_${Math.random().toString(36).substring(2, 8)}`;
};

const SiteContext = createContext();

export function SiteProvider({ children }) {
  const [siteData, setSiteData] = useState(() => {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      try {
        const parsed = JSON.parse(saved);
        
        let loadedProjects = parsed.projects?.length ? parsed.projects : INITIAL_PROJECTS;
        loadedProjects = loadedProjects.map(p => {
          if (p.title === "ديوان عربي فاخر" || p.id == 2) p.title = "ديوان عربي"; if (p.title === "مجلس" && p.image && (p.image.includes("portfolio_majlis_modern") || p.image.includes("1600607687920"))) {
             p.image = "https://images.unsplash.com/photo-1618221118493-9c48ea92a955?auto=format&fit=crop&w=1200&q=80";
             if (p.coverImage) p.coverImage = p.image;
             if (Array.isArray(p.gallery)) {
               p.gallery = p.gallery.map(g => (g.includes("portfolio_majlis_modern") || g.includes("1600607687920")) ? p.image : g);
             }
          }
          if ((p.title === "مقر شركة إقليمية" || p.title === "مكتب شركة" || p.title === "مكتب شركات")) {
             p.title = "مكتب شركة";
             p.categoryLabel = "مكاتب";
          }
          return {
            ...p,
            gallery: p.gallery !== undefined ? p.gallery : (p.image ? [`${p.image}?g=1`, `${p.image}?g=2`, `${p.image}?g=3`] : [])
          };
        });

        return {
          services: ensureUniqueIds(parsed.services?.length ? parsed.services : INITIAL_SERVICES, "s"),
          projects: ensureUniqueIds(loadedProjects, "p"),
          testimonials: ensureUniqueIds(parsed.testimonials?.length ? parsed.testimonials : INITIAL_TESTIMONIALS, "t"),
          media: ensureUniqueIds(parsed.media?.length ? parsed.media : INITIAL_MEDIA, "m"),
          users: ensureUniqueIds(INITIAL_USERS, "u"), // Only primary super admin
          assetMap: parsed.assetMap || {},
          brand: (() => {
            const b = { ...INITIAL_BRAND, ...parsed.brand, email: parsed.brand?.email || "", facebook: parsed.brand?.facebook || "", snapchat: parsed.brand?.snapchat || "", phone2: parsed.brand?.phone2 || "" };
            if (!b.tagline || b.tagline === "نحوّل المساحات إلى تحف فنية") {
              b.tagline = INITIAL_BRAND.tagline;
            }
            return b;
          })(),
          pageConfig: {
            ...INITIAL_PAGE_CONFIG,
            ...parsed.pageConfig,
            homePage: { ...INITIAL_PAGE_CONFIG.homePage, ...parsed.pageConfig?.homePage },
            aboutPage: { ...INITIAL_PAGE_CONFIG.aboutPage, ...parsed.pageConfig?.aboutPage },
            servicesPage: { ...INITIAL_PAGE_CONFIG.servicesPage, ...parsed.pageConfig?.servicesPage },
            portfolioPage: { ...INITIAL_PAGE_CONFIG.portfolioPage, ...parsed.pageConfig?.portfolioPage },
            footer: { ...INITIAL_PAGE_CONFIG.footer, ...parsed.pageConfig?.footer },
          },
        };
      } catch (e) {
        console.error("Failed to parse site storage", e);
      }
    }
    return {
      services: ensureUniqueIds(INITIAL_SERVICES, "s"),
      projects: ensureUniqueIds(INITIAL_PROJECTS, "p"),
      testimonials: ensureUniqueIds(INITIAL_TESTIMONIALS, "t"),
      media: ensureUniqueIds(INITIAL_MEDIA, "m"),
      users: ensureUniqueIds(INITIAL_USERS, "u"),
      brand: INITIAL_BRAND,
      pageConfig: INITIAL_PAGE_CONFIG,
    };
  });

  const [syncStatus, setSyncStatus] = useState("synced"); // 'synced' | 'saving'
  const [lastSyncedAt, setLastSyncedAt] = useState(() => new Date().toLocaleTimeString("ar-YE", { hour: "2-digit", minute: "2-digit" }));
  const [isInitialLoading, setIsInitialLoading] = useState(false);
  const isFirstMount = useRef(true);

  // Helper to fetch server data and update state
  const fetchServerData = async () => {
    try {
      const res = await fetch("/api/site-data");
      if (res.ok) {
        const data = await res.json();
        if (data && data.services && Array.isArray(data.services)) {
          setSiteData((prev) => {
            if (true) { // Always update on fetch
              let serverProjects = data.projects || [];
              serverProjects = serverProjects.map(p => {
                if (p.title === "ديوان عربي فاخر" || p.id == 2) p.title = "ديوان عربي"; if (p.title === "مجلس" && p.image && (p.image.includes("portfolio_majlis_modern") || p.image.includes("1600607687920"))) {
                   p.image = "https://images.unsplash.com/photo-1618221118493-9c48ea92a955?auto=format&fit=crop&w=1200&q=80";
                   if (p.coverImage) p.coverImage = p.image;
                   if (Array.isArray(p.gallery)) {
                     p.gallery = p.gallery.map(g => (g.includes("portfolio_majlis_modern") || g.includes("1600607687920")) ? p.image : g);
                   }
                }
                if ((p.title === "مقر شركة إقليمية" || p.title === "مكتب شركة" || p.title === "مكتب شركات")) {
             p.title = "مكتب شركة";
             p.categoryLabel = "مكاتب";
          }
          return {
                  ...p,
                  gallery: p.gallery !== undefined ? p.gallery : (p.image ? [`${p.image}?g=1`, `${p.image}?g=2`, `${p.image}?g=3`] : [])
                };
              });

              const updated = {
                ...data,
                services: ensureUniqueIds(data.services, "s"),
                projects: ensureUniqueIds(serverProjects, "p"),
                testimonials: ensureUniqueIds(data.testimonials, "t"),
                media: ensureUniqueIds(data.media, "m"),
                users: INITIAL_USERS,
                assetMap: data.assetMap || {},
                brand: { ...INITIAL_BRAND, ...data.brand },
                pageConfig: {
                  ...INITIAL_PAGE_CONFIG,
                  ...data.pageConfig,
                  homePage: { ...INITIAL_PAGE_CONFIG.homePage, ...data.pageConfig?.homePage },
                  aboutPage: { ...INITIAL_PAGE_CONFIG.aboutPage, ...data.pageConfig?.aboutPage },
                  servicesPage: { ...INITIAL_PAGE_CONFIG.servicesPage, ...data.pageConfig?.servicesPage },
                  portfolioPage: { ...INITIAL_PAGE_CONFIG.portfolioPage, ...data.pageConfig?.portfolioPage },
                  footer: { ...INITIAL_PAGE_CONFIG.footer, ...data.pageConfig?.footer },
                }
              };
                            // Inject preloads for critical images
              if (typeof document !== "undefined") {
                const criticalImages = [
                  updated.brand?.logo,
                  updated.pageConfig?.homePage?.hero?.backgroundImage
                ].filter(Boolean);
                
                if (updated.projects && updated.projects.length > 0) {
                   // Preload first 2-3 portfolio images as well
                   const firstProjects = updated.projects.filter(p => p.featured).slice(0, 3);
                   firstProjects.forEach(p => {
                     if (p.image) criticalImages.push(p.image);
                   });
                }
                
                criticalImages.forEach(src => {
                  if (!document.querySelector(`link[href="${src}"]`)) {
                    const link = document.createElement("link");
                    link.rel = "preload";
                    link.as = "image";
                    link.href = src;
                    document.head.appendChild(link);
                  }
                });
              }

              localStorage.setItem(STORAGE_KEY, JSON.stringify(updated));
              return updated;
            }
            return prev;
          });
        }
      }
    } catch (err) {
      // Ignore network errors on polling
    }
  };

  // Initial fetch from server + periodic live poll across all devices & instant storage event
  useEffect(() => {
    fetchServerData().finally(() => setIsInitialLoading(false));
    const interval = setInterval(fetchServerData, 5000);

    return () => clearInterval(interval);
  }, []);

  // Save to server API & localStorage whenever siteData changes
  useEffect(() => {
    if (isFirstMount.current) {
      isFirstMount.current = false;
      return;
    }
    setSyncStatus("saving");
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(siteData));
    } catch (e) {
      console.error("Storage error:", e);
    }

    // Sync to Server Endpoint
    fetch("/api/site-data", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(siteData),
    }).catch((err) => console.warn("Server sync error:", err));

    const timer = setTimeout(() => {
      setSyncStatus("synced");
      setLastSyncedAt(new Date().toLocaleTimeString("ar-YE", { hour: "2-digit", minute: "2-digit" }));
    }, 400);
    return () => clearTimeout(timer);
  }, [siteData]);

  // Backup System: Export JSON
  const exportAllData = () => {
    const dataToExport = {
      ...siteData,
      exportMeta: {
        exportedAt: new Date().toISOString(),
        version: "3.0",
        appName: "Aden Decor Admin Panel",
      },
    };
    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(dataToExport, null, 2));
    const downloadAnchor = document.createElement("a");
    const dateStr = new Date().toISOString().slice(0, 10);
    downloadAnchor.setAttribute("href", dataStr);
    downloadAnchor.setAttribute("download", `aden_decor_backup_${dateStr}.json`);
    document.body.appendChild(downloadAnchor);
    downloadAnchor.click();
    downloadAnchor.remove();
  };

  // Backup System: Import JSON
  const importAllData = (importedData) => {
    if (!importedData || typeof importedData !== "object") {
      throw new Error("ملف البيانات غير صالح");
    }

    const merged = {
      services: Array.isArray(importedData.services) ? importedData.services : INITIAL_SERVICES,
      projects: Array.isArray(importedData.projects) ? importedData.projects : INITIAL_PROJECTS,
      testimonials: Array.isArray(importedData.testimonials) ? importedData.testimonials : INITIAL_TESTIMONIALS,
      media: Array.isArray(importedData.media) ? importedData.media : INITIAL_MEDIA,
      users: Array.isArray(importedData.users) ? importedData.users : INITIAL_USERS,
      brand: { ...INITIAL_BRAND, ...(importedData.brand || {}) },
      assetMap: importedData.assetMap || {},
      pageConfig: {
        ...INITIAL_PAGE_CONFIG,
        ...(importedData.pageConfig || {}),
        homePage: { ...INITIAL_PAGE_CONFIG.homePage, ...(importedData.pageConfig?.homePage || {}) },
        aboutPage: { ...INITIAL_PAGE_CONFIG.aboutPage, ...(importedData.pageConfig?.aboutPage || {}) },
        servicesPage: { ...INITIAL_PAGE_CONFIG.servicesPage, ...(importedData.pageConfig?.servicesPage || {}) },
        portfolioPage: { ...INITIAL_PAGE_CONFIG.portfolioPage, ...(importedData.pageConfig?.portfolioPage || {}) },
        footer: { ...INITIAL_PAGE_CONFIG.footer, ...(importedData.pageConfig?.footer || {}) },
      },
    };

    setSiteData(merged);
    localStorage.setItem(STORAGE_KEY, JSON.stringify(merged));
  };

  // Actions
  const updateServices = (services) => {
    setSiteData((prev) => ({ ...prev, services }));
  };

  const addService = (service) => {
    const newService = {
      ...service,
      id: service.id || generateUniqueId("s"),
      order: service.order || siteData.services.length + 1,
    };
    setSiteData((prev) => ({
      ...prev,
      services: [...prev.services, newService],
    }));
  };

  const updateService = (id, updatedFields) => {
    setSiteData((prev) => ({
      ...prev,
      services: prev.services.map((s) => (s.id === id ? { ...s, ...updatedFields } : s)),
    }));
  };

  const deleteService = (id) => {
    setSiteData((prev) => ({
      ...prev,
      services: prev.services.filter((s) => s.id !== id),
    }));
  };

  const updateProjects = (projects) => {
    setSiteData((prev) => ({
      ...prev,
      last_updated: new Date().toISOString(),
      projects,
    }));
  };

  const addProject = (project) => {
    const newProject = {
      ...project,
      id: project.id || generateUniqueId("p"),
      order: project.order || siteData.projects.length + 1,
    };
    setSiteData((prev) => ({
      ...prev,
      last_updated: new Date().toISOString(),
      projects: [...prev.projects, newProject],
    }));
  };

  const updateProject = (id, updatedFields) => {
    setSiteData((prev) => ({
      ...prev,
      last_updated: new Date().toISOString(),
      projects: prev.projects.map((p) => (p.id === id ? { ...p, ...updatedFields } : p)),
    }));
  };

  const deleteProject = (id) => {
    setSiteData((prev) => ({
      ...prev,
      last_updated: new Date().toISOString(),
      projects: prev.projects.filter((p) => p.id !== id),
    }));
  };

  const updateTestimonials = (testimonials) => {
    setSiteData((prev) => ({ ...prev, testimonials }));
  };

  const addTestimonial = (testimonial) => {
    const newTestimonial = {
      ...testimonial,
      id: testimonial.id || generateUniqueId("t"),
      order: testimonial.order || siteData.testimonials.length + 1,
    };
    setSiteData((prev) => ({
      ...prev,
      testimonials: [...prev.testimonials, newTestimonial],
    }));
  };

  const updateTestimonial = (id, updatedFields) => {
    setSiteData((prev) => ({
      ...prev,
      testimonials: prev.testimonials.map((t) => (t.id === id ? { ...t, ...updatedFields } : t)),
    }));
  };

  const deleteTestimonial = (id) => {
    setSiteData((prev) => ({
      ...prev,
      testimonials: prev.testimonials.filter((t) => t.id !== id),
    }));
  };

  const addMedia = (mediaItem) => {
    const newMedia = {
      ...mediaItem,
      id: mediaItem.id || generateUniqueId("m"),
      uploaded_at: mediaItem.uploaded_at || new Date().toISOString(),
    };
    setSiteData((prev) => ({
      ...prev,
      media: [newMedia, ...prev.media],
    }));
    return newMedia;
  };

  const deleteMedia = (id) => {
    setSiteData((prev) => ({
      ...prev,
      media: prev.media.filter((m) => m.id !== id),
    }));
  };

  const addUser = (user) => {
    const newUser = {
      ...user,
      id: user.id || generateUniqueId("u"),
      created_at: user.created_at || new Date().toISOString(),
    };
    setSiteData((prev) => ({
      ...prev,
      users: [...(prev.users || []), newUser],
    }));
    return newUser;
  };

  const updateUserInContext = (id, fields) => {
    setSiteData((prev) => ({
      ...prev,
      users: (prev.users || []).map((u) => (u.id === id ? { ...u, ...fields } : u)),
    }));
  };

  const deleteUserInContext = (id) => {
    setSiteData((prev) => ({
      ...prev,
      users: (prev.users || []).filter((u) => u.id !== id),
    }));
  };

  const updateBrand = (newBrand) => {
    setSiteData((prev) => ({
      ...prev,
      last_updated: new Date().toISOString(),
      brand: { ...prev.brand, ...newBrand },
    }));
  };

  const updatePageConfig = (pageKey, sectionKey, fields) => {
    setSiteData((prev) => ({
      ...prev,
      last_updated: new Date().toISOString(),
      pageConfig: {
        ...prev.pageConfig,
        [pageKey]: {
          ...prev.pageConfig[pageKey],
          [sectionKey]: {
            ...(prev.pageConfig[pageKey]?.[sectionKey] || {}),
            ...fields,
          },
        },
      },
    }));
  };

  const setEntirePageConfig = (newConfig) => {
    setSiteData((prev) => ({
      ...prev,
      last_updated: new Date().toISOString(),
      pageConfig: {
        ...prev.pageConfig,
        ...newConfig,
      },
    }));
  };

  const resetDefaults = () => {
    setSiteData({
      services: INITIAL_SERVICES,
      projects: INITIAL_PROJECTS,
      testimonials: INITIAL_TESTIMONIALS,
      media: INITIAL_MEDIA,
      brand: INITIAL_BRAND,
      pageConfig: INITIAL_PAGE_CONFIG,
    });
    localStorage.removeItem(STORAGE_KEY);
  };

  if (isInitialLoading) {
    return (
      <div className="fixed inset-0 bg-[#0a0a0a] flex items-center justify-center z-[9999]">
        <div className="flex flex-col items-center">
          <div className="w-12 h-12 border-4 border-[#D4AF37] border-t-transparent rounded-full animate-spin mb-4"></div>
          <p className="text-[#D4AF37] font-body text-lg">جاري التحميل...</p>
        </div>
      </div>
    );
  }

  return (
    <SiteContext.Provider
      value={{
        siteData,
        services: siteData.services,
        projects: siteData.projects,
        testimonials: siteData.testimonials,
        media: siteData.media,
        users: siteData.users || [],
        brand: siteData.brand,
        pageConfig: siteData.pageConfig,
        syncStatus,
        lastSyncedAt,
        exportAllData,
        importAllData,
        updateServices,
        addService,
        updateService,
        deleteService,
        updateProjects,
        addProject,
        updateProject,
        deleteProject,
        updateTestimonials,
        addTestimonial,
        updateTestimonial,
        deleteTestimonial,
        addMedia,
        deleteMedia,
        addUser,
        updateUserInContext,
        deleteUserInContext,
        updateBrand,
        updatePageConfig,
        setEntirePageConfig,
        resetDefaults,
      }}
    >
      {children}
    </SiteContext.Provider>
  );
}

export function useSiteData() {
  const ctx = useContext(SiteContext);
  if (!ctx) {
    throw new Error("useSiteData must be used within a SiteProvider");
  }
  return ctx;
}
